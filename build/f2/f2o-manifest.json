  "content": "<!-- wp:html -->\n<style>\n.ei-wrap{max-width:1100px;margin:0 auto;padding:0 20px}\n.ei-btn-blue{background:rgba(32,135,201,1);color:#fff !important;padding:13px 26px;border-radius:6px;font-weight:700;font-size:0.95em;text-transform:uppercase;text-decoration:none !important;display:inline-block;line-height:1.4;text-align:center;min-width:120px}\n.ei-section{padding:26px 20px}\n.ei-section-alt{background:#f7f9fc;padding:26px 20px}\n.ei-art .ei-h2{font-weight:800;color:#1a2340;margin:0 0 10px;font-size:1.45em;line-height:1.3}\n.ei-art > *:last-child{margin-bottom:0}\n.ei-art p{color:#4a5568;line-height:1.8}\n.ei-art a{color:rgba(32,135,201,1)}\n.ei-art ul{color:#4a5568;line-height:1.8}\n.ei-info{background:#f0f7fd;border-left:4px solid rgba(32,135,201,1);border-radius:0 8px 8px 0;padding:14px 18px;margin:18px 0}\n.ei-info p{margin:0;color:#1a2340;line-height:1.7}\n.ei-warn{background:#fffbf0;border-left:4px solid #f6ad1a;border-radius:0 8px 8px 0;padding:14px 18px;margin:18px 0}\n.ei-warn p{margin:0;color:#7c5800;line-height:1.7}\n.ei-danger{background:#fff5f5;border-left:4px solid #e53e3e;border-radius:0 8px 8px 0;padding:14px 18px;margin:18px 0}\n.ei-danger p{margin:0;color:#742a2a;line-height:1.7}\n.ei-hero{background:linear-gradient(135deg,#0f1624 0%,#1a2340 55%,#1e3a6e 100%);padding:40px 20px}\n.ei-hero-inner{max-width:860px;margin:0 auto;text-align:center}\n.ei-hero-eyebrow{display:inline-block;background:rgba(32,135,201,0.15);border:1px solid rgba(32,135,201,0.4);border-radius:50px;padding:5px 16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(32,135,201,1);margin-bottom:16px;font-size:.8em}\n.ei-hero h1{color:#fff;font-weight:800;line-height:1.2;margin:0 0 14px;font-size:2.1em}\n.ei-hero h1 span{color:#f6ad1a}\n.ei-hero-sub{color:rgba(255,255,255,0.78);max-width:720px;margin:0 auto 10px;line-height:1.75}\n.ei-hero-by{color:rgba(255,255,255,0.6);max-width:720px;margin:0 auto 22px;line-height:1.6;font-size:.86em}\n.ei-hero-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\n.ei-tbl{width:100%;border-collapse:collapse;margin:18px 0;border:1px solid #d1d5db}\n.ei-tbl th{background:#1a2340;color:#fff;font-weight:700;padding:12px 14px;text-align:left;border:1px solid #374151}\n.ei-tbl td{padding:10px 14px;border:1px solid #d1d5db;color:#2d3748;line-height:1.5}\n.ei-tbl tr:nth-child(even){background:#f7f9fc}\n.ei-tbl tr:hover{background:#edf2f7}\n.ei-updated{color:#718096;font-size:.9em;margin:0 0 18px}\n.ei-toc{background:linear-gradient(180deg,#ffffff,#f7f9fc);border:1px solid #e2e8f0;border-radius:12px;padding:18px 22px;margin:0 0 10px;box-shadow:0 1px 2px rgba(26,35,64,.05)}\n.ei-toc h2{font-size:.76em;font-weight:800;color:#8795ab;margin:0 0 10px;text-transform:uppercase;letter-spacing:1.3px}\n.ei-toc ol{margin:0;padding:0;list-style:none;counter-reset:toc;columns:2;column-gap:30px}\n.ei-toc li{break-inside:avoid;counter-increment:toc;margin:0}\n.ei-toc a{display:flex;gap:10px;align-items:baseline;padding:6px 9px;border-radius:6px;color:#1a2340;text-decoration:none;line-height:1.45}\n.ei-toc a::before{content:counter(toc);color:rgba(32,135,201,1);font-weight:800;font-size:.82em;min-width:15px;flex-shrink:0}\n.ei-toc a:hover{background:#eaf3fb;color:rgba(32,135,201,1);text-decoration:none}\n.ei-cta-inline{background:#1a2340;border-radius:10px;padding:24px 28px;margin:28px 0;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}\n.ei-cta-inline h3{color:#fff;margin:0 0 4px;font-weight:700}\n.ei-cta-inline p{color:rgba(255,255,255,0.65);margin:0}\n.ei-cta-inline a,.ei-cta-inline a:visited,.ei-cta-inline a:hover,.ei-cta-bottom a,.ei-cta-bottom a:visited,.ei-cta-bottom a:hover,.ei-hero-btns a,.ei-hero-btns a:visited,.ei-hero-btns a:hover{color:#fff !important;text-decoration:none !important}\n.ei-faq{max-width:900px;margin:16px auto 0}\n.ei-faq details{border:1px solid #e2e8f0;border-radius:8px;margin-bottom:9px;background:#fff}\n.ei-faq summary{padding:14px 18px;font-weight:600;color:#1a2340;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:14px;line-height:1.5}\n.ei-faq summary::-webkit-details-marker{display:none}\n.ei-faq summary::after{content:'+';color:rgba(32,135,201,1);font-weight:400;font-size:1.4em;line-height:1;flex-shrink:0;transition:transform .15s ease}\n.ei-faq details[open] summary{color:rgba(32,135,201,1)}\n.ei-faq details[open] summary::after{transform:rotate(45deg)}\n.ei-faq .ei-faq-a{padding:0 18px 15px}\n.ei-faq .ei-faq-a p{margin:0;color:#4a5568;line-height:1.75}\n.ei-art h3{font-weight:700;color:#1a2340;margin:26px 0 8px;font-size:1.15em}\n.ei-qlist{max-width:900px;margin:12px auto 0;padding:0;list-style:none}\n.ei-qlist li{border:1px solid #e2e8f0;border-radius:8px;margin-bottom:10px;background:#fff}\n.ei-qlist a{display:block;padding:16px 20px;font-weight:600;color:#1a2340 !important;text-decoration:none !important}\n.ei-qlist a:hover{background:#f7f9fc;color:rgba(32,135,201,1) !important}\n.ei-cta-bottom{background:linear-gradient(135deg,#0f1624,#1a2340);padding:40px 20px;text-align:center}\n.ei-cta-bottom h2{color:#fff;font-weight:800;margin:0 0 10px;font-size:1.5em}\n.ei-cta-bottom p{color:rgba(255,255,255,0.72);max-width:600px;margin:0 auto 22px;line-height:1.75}\n.entry-header{display:none!important}\n.ast-article-single,.ast-article-single .entry-content{margin-top:0;padding-top:0}\n@media(max-width:900px){.ei-cta-inline{flex-direction:column;text-align:center}.ei-hero h1{font-size:1.6em}.ei-art .ei-h2{font-size:1.3em}.ei-toc ol{columns:1}}\n\n/* Narrower than the guides' 1100px, at Navneet's request. 1000px is the\n   measure the Family 4 service pages already use, so this is a house value\n   rather than a new one. The hero band stays full-bleed: it is .ei-hero that\n   spans, and .ei-hero-inner caps its text at 860px, so neither is touched.\n\n   A service page has exactly one band that spans the viewport, the hero. The\n   guides alternate white and grey .ei-section bands, which span whatever the\n   window is and make the body read full width even with the text capped at\n   1000px. Dropping the grey leaves one continuous column, which is what a\n   service page looks like. The hero still spans. */\n.ei-wrap{max-width:1000px}\n.ei-section-alt{background:none}\n/* The FAQ and Read Next lists come from the guides capped at 900px and\n   centred with auto margins. In the guides' 1100px column that reads as a\n   deliberate inset; in this 1000px one it just leaves them narrower than,\n   and off-axis from, their own H2 and the body copy above. Run them the\n   full measure of the column instead. */\n.ei-faq,.ei-qlist{max-width:none;margin-left:0;margin-right:0}\n/* 1000px, the same measure as .cnf-w on the Family 4 service pages, which\n   Navneet confirmed read correctly.\n\n   !important, which is not decoration here. Measured against a service\n   page screenshot at the same window, the tool body was rendering around\n   1250px: wider than the 1100px base AND wider than the 1000px override,\n   so neither .ei-wrap rule was binding. Two successive specificity levels\n   (0,1,0 then 0,2,0) changed nothing on the front end. Whatever sets the\n   width wins on specificity or carries !important itself, so this does\n   too. The margins are forced with it so the column still centres if the\n   same rule also set a margin.\n\n   The hero is not in the selector and does not move. */\n.ei-wrap.ei-art,.ei-cta-bottom .ei-wrap{max-width:1000px!important;margin-left:auto!important;margin-right:auto!important}\n/* Dark navy calculator panel, after the gondaliyacpa.ca sample Navneet sent.\n\n   The panel is the only thing on the page that asks for input, and as a white\n   card on a white body it read as more body copy. Navy separates the thing you\n   do from the thing you read, which is the whole point of the sample's design.\n\n   Every selector below carries one class more than the base rule it replaces,\n   because the base rules sit earlier in this same stylesheet and some of them\n   (.ei-yn label) are already two-class. The result box is deliberately left\n   light: on navy it reads as the answer card, and its green and red variants\n   still carry the eligible / not eligible meaning. */\n.ei-art .ei-tool{background:#1a2340;border:0;border-radius:14px;\n  padding:28px 30px;box-shadow:0 10px 30px rgba(15,22,36,.18)}\n.ei-art .ei-tool legend{color:#f6ad1a;font-size:1.15em;padding:0 0 14px}\n.ei-art .ei-f label{color:rgba(255,255,255,.82)}\n.ei-art .ei-f input[type=date]{background:rgba(255,255,255,.09);\n  border:1.5px solid rgba(255,255,255,.28);color:#fff;font-weight:700;\n  color-scheme:dark;padding:11px 13px}\n.ei-art .ei-f input[type=date]:focus{border-color:rgba(32,135,201,1);\n  background:rgba(32,135,201,.2);outline:none}\n/* No filter here. color-scheme:dark above already makes Chrome draw the\n   picker glyph light; inverting it on top turned it black again, which is\n   what Navneet's screenshot showed. Opacity only. */\n.ei-art .ei-f input[type=date]::-webkit-calendar-picker-indicator{\n  opacity:.9;cursor:pointer}\n.ei-art .ei-yn{border:1.5px solid rgba(255,255,255,.28)}\n.ei-art .ei-yn label{background:transparent;color:rgba(255,255,255,.75)}\n/* #1a7ab5, not the #2087c9 the base rule uses. White on #2087c9 is 3.91:1,\n   under the 4.5 that bold text at this size needs, and it was already that\n   way on the white card. #1a7ab5 is 4.67:1 and is not a new colour, it is\n   the hover shade .ei-btn-blue already uses. */\n.ei-art .ei-yn input:checked+span{background:#1a7ab5;color:#fff}\n.ei-art .ei-yn label:focus-within span{outline:2px solid #fff;outline-offset:-2px}\n.ei-art .ei-tool .ei-err{color:#ffb4ab}\n.ei-art .ei-tool .ei-out{box-shadow:0 2px 10px rgba(15,22,36,.22)}\n\n/* Hero tags, summary stats and the two-column compare, all after the\n   gondaliyacpa.ca sample. */\n.ei-hero-tags{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;\n  margin:0 0 16px}\n.ei-hero-tag{background:rgba(255,255,255,.08);\n  border:1px solid rgba(255,255,255,.18);border-radius:50px;padding:5px 14px;\n  color:rgba(255,255,255,.78);font-size:.85em;line-height:1.5}\n/* Stat cards sit inside .ei-out, which stays light, so these are white cards\n   on a pale result box rather than on the navy panel. */\n.ei-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;\n  margin:0 0 14px}\n.ei-stat{background:#fff;border:1px solid #e2e8f0;border-radius:10px;\n  padding:13px 15px}\n.ei-stat-l{display:block;color:#718096;font-size:.8em;margin:0 0 5px;\n  line-height:1.4}\n.ei-stat-v{display:block;font-weight:800;color:#1a2340;font-size:1.12em;\n  line-height:1.3}\n.ei-cmp{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:18px 0}\n.ei-cmp-col{border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;\n  background:#fff}\n.ei-cmp-col.a{border-top:3px solid rgba(32,135,201,1)}\n.ei-cmp-col.b{border-top:3px solid #f6ad1a}\n.ei-cmp-hdr{padding:14px 18px;font-weight:800;color:#1a2340}\n.ei-cmp-col.a .ei-cmp-hdr{background:rgba(32,135,201,.07)}\n.ei-cmp-col.b .ei-cmp-hdr{background:rgba(246,173,26,.07)}\n.ei-cmp-row{padding:11px 18px;border-top:1px solid #f0f0f0}\n.ei-cmp-l{display:block;color:#718096;font-size:.84em;margin:0 0 2px}\n.ei-cmp-v{display:block;color:#1a2340;line-height:1.55}\n@media(max-width:700px){.ei-stats{grid-template-columns:1fr}\n  .ei-cmp{grid-template-columns:1fr}}\n.ei-tool{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:22px 24px;margin:18px 0;box-shadow:0 1px 2px rgba(26,35,64,.05)}\n.ei-tool legend{font-weight:800;color:#1a2340;font-size:1.05em;padding:0 0 6px}\n.ei-tool fieldset{border:0;margin:0;padding:0}\n.ei-f{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:0 0 14px}\n.ei-f label{font-weight:600;color:#1a2340;flex:1 1 320px;line-height:1.5}\n.ei-f input[type=date]{font:inherit;padding:9px 11px;border:1px solid #cbd5e0;border-radius:7px;color:#1a2340;background:#fff}\n.ei-yn{display:inline-flex;border:1px solid #cbd5e0;border-radius:7px;overflow:hidden;flex:0 0 auto}\n.ei-yn label{flex:0 0 auto;margin:0;padding:8px 16px;cursor:pointer;font-weight:700;color:#4a5568;background:#fff;line-height:1.2}\n.ei-yn input{position:absolute;opacity:0;width:0;height:0}\n.ei-yn input:checked+span{background:rgba(32,135,201,1);color:#fff}\n.ei-yn span{display:block;padding:8px 16px;margin:-8px -16px}\n.ei-yn label:focus-within span{outline:2px solid #1a2340;outline-offset:-2px}\n.ei-out{margin:16px 0 0;padding:16px 18px;border-radius:9px;border-left:5px solid #cbd5e0;background:#f7f9fc}\n.ei-out.ok{border-left-color:#2f855a;background:#f0fff4}\n.ei-out.no{border-left-color:#c53030;background:#fff5f5}\n.ei-out h3{margin:0 0 6px;font-size:1.1em;color:#1a2340}\n.ei-out p{margin:0 0 8px;color:#4a5568;line-height:1.7}\n.ei-out ul{margin:6px 0 8px 20px;color:#4a5568;line-height:1.7}\n.ei-out .ei-note{font-size:.88em;color:#718096;margin:10px 0 0}\n.ei-big{font-size:1.5em;font-weight:800;color:rgba(32,135,201,1);display:block;margin:2px 0 6px}\n.ei-tool .ei-err{color:#c53030;font-weight:600;margin:6px 0 0}\n</style>\n<div class=\"ei-hero\"><div class=\"ei-hero-inner\"><span class=\"ei-hero-eyebrow\">Ontario</span><h1>Ontario Annual Return <span>Due Date Calculator</span></h1><p class=\"ei-hero-sub\">The Ontario annual return follows the fiscal year-end, not the incorporation date, and since October 2021 it is filed through the Ontario Business Registry.</p><div class=\"ei-hero-tags\"><span class=\"ei-hero-tag\">Six months after the year-end</span><span class=\"ei-hero-tag\">Not filed with the T2</span><span class=\"ei-hero-tag\">Ontario Business Registry</span><span class=\"ei-hero-tag\">Not covered by the fee</span></div><p class=\"ei-hero-by\">Written and reviewed by Sharad Gondaliya, CPA (Ontario), CPA Ontario Membership 61040184.</p><div class=\"ei-hero-btns\"><a class=\"ei-btn-blue\" href=\"https://corpnilfilingfor300.ca/form/\">Start Nil T2 Filing NOW</a></div></div></div>\n<div class=\"ei-section\"><div class=\"ei-wrap ei-art\">\n<p class=\"ei-updated\">Last reviewed: November 16, 2026</p>\n<div class=\"ei-tool\">\n<fieldset><legend>Your Ontario corporation and its fiscal year-end</legend>\n<div class=\"ei-f\"><label for=\"ye\">The fiscal year-end</label><input type=\"date\" id=\"ye\"></div>\n<div class=\"ei-f\"><label id=\"lont\">Incorporated or continued under Ontario law?</label><span class=\"ei-yn\" role=\"radiogroup\" aria-labelledby=\"lont\"><label><input type=\"radio\" name=\"ont\" value=\"y\"><span>Yes</span></label><label><input type=\"radio\" name=\"ont\" value=\"n\"><span>No</span></label></span></div>\n<div class=\"ei-f\"><label id=\"lsince\">Filed an Ontario annual return since October 2021?</label><span class=\"ei-yn\" role=\"radiogroup\" aria-labelledby=\"lsince\"><label><input type=\"radio\" name=\"since\" value=\"y\"><span>Yes</span></label><label><input type=\"radio\" name=\"since\" value=\"n\"><span>No</span></label></span></div>\n</fieldset>\n<div class=\"ei-out\" id=\"out\" role=\"status\" aria-live=\"polite\"><p>Enter the fiscal year-end and answer the two questions.</p></div>\n</div>\n<div class=\"ei-info\"><p>Gondaliya CPA Professional Corporation is a registered EFILE electronic filer. Returns are prepared and transmitted in Canada. Credentials are never shared and never used offshore.</p></div>\n</div></div>\n<div class=\"ei-section-alt\" id=\"the-date\"><div class=\"ei-wrap ei-art\">\n<h2 class=\"ei-h2\">The Date Comes From the Year-End</h2>\n<p>The Ontario annual return is due within six months after the end of the corporation&rsquo;s tax year. Not six months after incorporation, and not on the incorporation anniversary. A December 31 year-end makes it due June 30; a March 31 year-end makes it due September 30.</p>\n<p>That is the same six months the federal T2 runs on, so for any given year the two land on the same day. The Province does not hold your fiscal year-end on file, which is why no reminder arrives and why the date has to be worked out from the year-end rather than waited for.</p>\n</div></div>\n<div class=\"ei-section\" id=\"three-returns\"><div class=\"ei-wrap ei-art\">\n<h2 class=\"ei-h2\">Three Returns People Call the Annual Return</h2>\n<table class=\"ei-tbl\"><thead><tr><th scope=\"col\">The filing</th><th scope=\"col\">What the date turns on</th><th scope=\"col\">Filed with</th></tr></thead><tbody>\n<tr><td>Ontario annual return</td><td>Six months after the fiscal year-end</td><td>Ontario Business Registry</td></tr>\n<tr><td>Federal annual return</td><td>The incorporation anniversary, each year</td><td>Corporations Canada</td></tr>\n<tr><td>Federal T2 return</td><td>Six months after the fiscal year-end</td><td>Canada Revenue Agency, electronically</td></tr>\n</tbody></table>\n<p>The middle row is a different filing on a different clock, and the <a href=\"https://corpnilfilingfor300.ca/tools/federal-annual-return-anniversary-calculator/\">federal annual return anniversary calculator</a> handles it. The <a href=\"https://corpnilfilingfor300.ca/tools/annual-return-vs-tax-return-checker/\">annual return versus tax return checker</a> separates the first row from the third in more detail. This page is only about the first.</p>\n</div></div>\n<div class=\"ei-section-alt\" id=\"where-it-goes\"><div class=\"ei-wrap ei-art\">\n<h2 class=\"ei-h2\">Why the Route Changed, and What the Fee Covers</h2>\n<p>Until 2021 the Ontario annual return travelled with the T2 on Schedule 546. The Canada Revenue Agency stopped accepting it that way on May 15, 2021, and every return due after October 18, 2021 is filed through the Ontario Business Registry instead. The <a href=\"https://corpnilfilingfor300.ca/tools/schedule-546-ontario-annual-return-checker/\">Schedule 546 checker</a> covers what happened to the schedule, and the <a href=\"https://corpnilfilingfor300.ca/tools/ontario-business-registry-filing-checker/\">Ontario Business Registry filing checker</a> covers what else goes through the same system.</p>\n<p><a href=\"https://corpnilfilingfor300.ca/pricing/nil-t2-filing-cost/\">Nil T2 filing at $300.00 plus applicable sales tax per tax year</a> covers the T2 and not the Ontario annual return. We tell you the date this page works out, and the Registry filing stays yours to make. If several years have gone by unfiled, the <a href=\"https://corpnilfilingfor300.ca/tools/ontario-missed-annual-returns-calculator/\">Ontario missed annual returns calculator</a> counts how many are outstanding.</p>\n<p>The two filings share a date and nothing else: one is a tax return transmitted to the Canada Revenue Agency, the other is a corporate record filed with the Province of Ontario.</p>\n</div></div>\n<div class=\"ei-section\"><div class=\"ei-wrap ei-art\">\n<h2 class=\"ei-h2\">Frequently Asked Questions</h2>\n<div class=\"ei-faq\">\n<details><summary>When is the Ontario annual return due?</summary><div class=\"ei-faq-a\"><p>Within six months after the end of the corporation&rsquo;s tax year. A December 31 year-end makes it due June 30.</p></div></details>\n<details><summary>Is it due on the incorporation anniversary?</summary><div class=\"ei-faq-a\"><p>No. That is the federal annual return filed with Corporations Canada. The Ontario one runs from the fiscal year-end.</p></div></details>\n<details><summary>Is it the same date as the T2?</summary><div class=\"ei-faq-a\"><p>Yes, for the same year-end. Both run six months from the end of the tax year, which is exactly why the Ontario one is so often missed.</p></div></details>\n<details><summary>Is it filed with the T2?</summary><div class=\"ei-faq-a\"><p>Not since 2021. The Canada Revenue Agency stopped accepting it on May 15, 2021, and it goes through the Ontario Business Registry now.</p></div></details>\n<details><summary>Does a nil corporation still file it?</summary><div class=\"ei-faq-a\"><p>Yes. It is a corporate record filing rather than a tax return, so having earned nothing in the year does not remove it.</p></div></details>\n<details><summary>Is it included in the fee?</summary><div class=\"ei-faq-a\"><p>No. The fee covers the federal T2. The Ontario annual return is a Registry transaction we do not make on your behalf.</p></div></details>\n<details><summary>What happens if it is never filed?</summary><div class=\"ei-faq-a\"><p>The corporation falls out of compliance with the Province and can eventually be dissolved by the Ministry for it.</p></div></details>\n<details><summary>What if the due date is a Saturday?</summary><div class=\"ei-faq-a\"><p>The next-business-day shift is a Canada Revenue Agency administrative rule for the T2. This site states no such rule for the Registry.</p></div></details>\n<details><summary>My corporation is federal but operates in Ontario.</summary><div class=\"ei-faq-a\"><p>Then the annual return it files is the federal one on its anniversary. Extra-provincial registration is a separate question again.</p></div></details>\n<details><summary>How many can be outstanding at once?</summary><div class=\"ei-faq-a\"><p>One for every year since the last one filed. Nothing caps the number, and they do not merge into a single catch-up filing.</p></div></details>\n</div>\n</div></div>\n<div class=\"ei-section\"><div class=\"ei-wrap ei-art\">\n<h2 class=\"ei-h2\">Read Next</h2>\n<ul class=\"ei-qlist\">\n<li><a href=\"https://corpnilfilingfor300.ca/tools/ontario-business-registry-filing-checker/\">Ontario Business Registry filing checker</a></li>\n<li><a href=\"https://corpnilfilingfor300.ca/tools/ontario-missed-annual-returns-calculator/\">Ontario missed annual returns calculator</a></li>\n<li><a href=\"https://corpnilfilingfor300.ca/tools/schedule-546-ontario-annual-return-checker/\">Schedule 546 Ontario annual return checker</a></li>\n<li><a href=\"https://corpnilfilingfor300.ca/tools/federal-annual-return-anniversary-calculator/\">Federal annual return anniversary calculator</a></li>\n<li><a href=\"https://corpnilfilingfor300.ca/tools/annual-return-vs-tax-return-checker/\">Annual return versus tax return checker</a></li>\n<li><a href=\"https://corpnilfilingfor300.ca/tools/next-t2-due-date-checker/\">Next T2 due date checker</a></li>\n</ul>\n</div></div>\n<div class=\"ei-cta-bottom\"><div class=\"ei-wrap\"><h2>Nil T2 Filing, $300.00 plus applicable sales tax per tax year</h2><p>Type your corporation name, pick your unfiled years, pay, and sign Form T183CORP on a secure screen. Your CRA confirmation is emailed within 3 business days.</p><a class=\"ei-btn-blue\" href=\"https://corpnilfilingfor300.ca/form/\">Start Nil T2 Filing NOW</a></div></div>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"WebPage\", \"@id\": \"https://corpnilfilingfor300.ca/tools/ontario-annual-return-due-date-calculator/#webpage\", \"url\": \"https://corpnilfilingfor300.ca/tools/ontario-annual-return-due-date-calculator/\", \"name\": \"Ontario Annual Return Due Date Calculator | When It Is Due\", \"description\": \"The Ontario annual return follows the fiscal year-end, not the incorporation date, and since October 2021 it is filed through the Ontario Business Registry.\", \"inLanguage\": \"en-CA\", \"dateModified\": \"2026-11-16\", \"author\": {\"@type\": \"Person\", \"name\": \"Sharad Gondaliya\", \"honorificSuffix\": \"CPA\", \"url\": \"https://corpnilfilingfor300.ca/sharad-gondaliya-cpa/\"}}, {\"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Nil T2 filing in Canada\", \"item\": \"https://corpnilfilingfor300.ca/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Tools\", \"item\": \"https://corpnilfilingfor300.ca/tools/\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ontario Annual Return Due Date Calculator\", \"item\": \"https://corpnilfilingfor300.ca/tools/ontario-annual-return-due-date-calculator/\"}]}]}</script>\n<script>\n(function(){\nvar PRICE_JS=\"$300.00 plus applicable sales tax per tax year\";\nvar DISC_JS=\"This tool gives general information and is not a filed return.\";\nvar NOTNILJS=\"A holding corporation with investment income, a rental corporation and a corporation that paid or received a dividend are not nil. Those are handled by Gondaliya CPA Professional Corporation at gondaliyacpa.ca at $350.00 plus applicable sales tax per year.\";var QUALJS=\"A true nil return carries no percentage late-filing penalty, because that penalty is a percentage of tax owing and the corporation owes $0.00. The unfiled year still stays open forever, invites a demand to file and an arbitrary assessment, blocks a clearance certificate and dissolution, and costs a non-resident-owned corporation $25.00 per day up to $2,500.00.\";\n\nvar MON=['January','February','March','April','May','June','July','August',\n         'September','October','November','December'];\nvar DAY=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nfunction u(y,m,d){return new Date(Date.UTC(y,m,d));}\nfunction lastDay(y,m){return new Date(Date.UTC(y,m+1,0)).getUTCDate();}\nfunction fmt(dt){return MON[dt.getUTCMonth()]+' '+dt.getUTCDate()+', '+dt.getUTCFullYear();}\nfunction nthMon(y,m,n){var d=u(y,m,1);return u(y,m,1+((1-d.getUTCDay()+7)%7)+7*(n-1));}\nfunction monOnOrBefore(y,m,day){var d=u(y,m,day);return u(y,m,day-((d.getUTCDay()+6)%7));}\nfunction easter(y){\n  var a=y%19,b=Math.floor(y/100),c=y%100,d=Math.floor(b/4),e=b%4,\n      f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,\n      i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,\n      m=Math.floor((a+11*h+22*l)/451),\n      mo=Math.floor((h+l-7*m+114)/31),da=((h+l-7*m+114)%31)+1;\n  return u(y,mo-1,da);\n}\nfunction holidays(y){\n  var e=easter(y),gf=new Date(e.getTime()-2*86400000);\n  return [u(y,0,1),nthMon(y,1,3),gf,monOnOrBefore(y,4,24),u(y,6,1),\n          nthMon(y,8,1),nthMon(y,9,2),u(y,11,25),u(y,11,26)];\n}\nvar HCACHE={};\nfunction isHoliday(dt){\n  var y=dt.getUTCFullYear();\n  if(!HCACHE[y]){HCACHE[y]={};holidays(y).forEach(function(h){HCACHE[y][h.getTime()]=1;});}\n  return !!HCACHE[y][dt.getTime()];\n}\nfunction isBusiness(dt){\n  var w=dt.getUTCDay();\n  return w!==0&&w!==6&&!isHoliday(dt);\n}\nfunction nextBusiness(dt){\n  var d=new Date(dt.getTime());\n  while(!isBusiness(d)){d=new Date(d.getTime()+86400000);}\n  return d;\n}\nfunction businessBetween(from,to){\n  var n=0,d=new Date(from.getTime()+86400000),lim=to.getTime();\n  while(!(d.getTime() > lim)){if(isBusiness(d)){n++;}d=new Date(d.getTime()+86400000);}\n  return n;\n}\nfunction today(){var n=new Date();return u(n.getFullYear(),n.getMonth(),n.getDate());}\nfunction dueDate(ye){\n  var y=ye.getUTCFullYear(),m=ye.getUTCMonth(),d=ye.getUTCDate();\n  var endOfMonth=(d===lastDay(y,m));\n  var tm=m+6,ty=y+Math.floor(tm/12);tm=((tm%12)+12)%12;\n  if(endOfMonth){return u(ty,tm+1,0);}\n  return u(ty,tm,Math.min(d,lastDay(ty,tm)));\n}\nfunction addYear(dt,k){\n  var y=dt.getUTCFullYear(),m=dt.getUTCMonth(),d=dt.getUTCDate();\n  if(d===lastDay(y,m)){return u(y+k,m+1,0);}\n  return u(y+k,m,Math.min(d,lastDay(y+k,m)));\n}\nfunction addMonths(dt,n){\n  var y=dt.getUTCFullYear(),m=dt.getUTCMonth(),d=dt.getUTCDate();\n  var endOfMonth=(d===lastDay(y,m));\n  var tm=m+n,ty=y+Math.floor(tm/12);tm=((tm%12)+12)%12;\n  if(endOfMonth){return u(ty,tm+1,0);}\n  return u(ty,tm,Math.min(d,lastDay(ty,tm)));\n}\nfunction parse(id){var v=document.getElementById(id).value;\n  if(!v){return null;}var p=v.split('-');var d=u(+p[0],+p[1]-1,+p[2]);\n  return isNaN(d.getTime())?undefined:d;}\nfunction spanDays(a,b){\n  return Math.round((b.getTime()-a.getTime())/86400000)+1;\n}\nfunction filingDate(ye){return nextBusiness(dueDate(ye));}\nfunction dayAfter(dt){return new Date(dt.getTime()+86400000);}\nfunction dayBefore(dt){return new Date(dt.getTime()-86400000);}\nfunction plural(n,w){return n+' '+w+(n===1?'':'s');}\nfunction pick(n){var e=document.querySelector('input[name=\"'+n+'\"]:checked');\n  return e?e.value:null;}\n\nvar out=document.getElementById('out');\nfunction show(){\n  var ye=parse('ye'),ont=pick('ont'),since=pick('since'),h,wait=0;\n  if(ye===null||ye===undefined){wait++;}\n  if(ont===null){wait++;}\n  if(since===null){wait++;}\n  if(wait>0){\n    out.innerHTML='<p>'+wait+' of the three entries '\n     +(wait===1?'is':'are')+' still to come.</p>';return;\n  }\n  var due=dueDate(ye),t2=dueDate(ye),shift=filingDate(ye);\n  if(ont==='n'){\n    h='<h3>This is not the return your corporation files</h3>';\n    h+='<p>The Ontario annual return is filed by a corporation incorporated '\n     +'or continued under Ontario law. A corporation incorporated federally '\n     +'files the Corporations Canada annual return instead, and that one '\n     +'turns on the incorporation anniversary rather than the year-end, so '\n     +'nothing below applies to it.</p>';\n    h+='<table class=\"ei-tbl\"><thead><tr><th scope=\"col\">Filing</th>'\n     +'<th scope=\"col\">What it turns on</th>'\n     +'<th scope=\"col\">Where it goes</th></tr></thead><tbody>'\n     +'<tr><td>Ontario annual return</td><td>The fiscal year-end</td>'\n     +'<td>Ontario Business Registry</td></tr>'\n     +'<tr><td>Federal annual return</td><td>The incorporation anniversary</td>'\n     +'<td>Corporations Canada</td></tr>'\n     +'<tr><td>Federal T2 return</td><td>The fiscal year-end</td>'\n     +'<td>Canada Revenue Agency</td></tr>'\n     +'</tbody></table>';\n    h+='<p>Your T2 for a year-end of '+fmt(ye)+' is still due '+fmt(t2)\n     +'. For the federal annual return, the '\n     +'<a href=\"https://corpnilfilingfor300.ca/tools/federal-annual-return-anniversary-calculator/\">federal annual return anniversary calculator</a> '\n     +'works from the incorporation date.</p>';\n    h+='<p>'+DISC_JS+'</p>';\n    out.innerHTML=h;return;\n  }\n  h='<h3>Both are due '+fmt(due)+'</h3>';\n  h+='<p>Six months after a year-end of '+fmt(ye)+'. The Ontario annual '\n   +'return and the federal T2 fall on the same date, which is the reason '\n   +'the Ontario one gets missed: it looks like part of the T2 and it is '\n   +'not.</p>';\n  h+='<table class=\"ei-tbl\"><thead><tr><th scope=\"col\">What is due</th>'\n   +'<th scope=\"col\">Date</th><th scope=\"col\">Filed where</th>'\n   +'<th scope=\"col\">Covered by the fee</th></tr></thead><tbody>';\n  h+='<tr><td>Fiscal year-end</td><td>'+fmt(ye)+'</td>'\n   +'<td>Nothing is filed on this date</td><td>Not applicable</td></tr>';\n  h+='<tr><td>Ontario annual return</td><td>'+fmt(due)+'</td>'\n   +'<td>Ontario Business Registry</td><td>No</td></tr>';\n  h+='<tr><td>Federal T2 return</td><td>'+fmt(t2)+'</td>'\n   +'<td>Canada Revenue Agency, electronically</td><td>Yes</td></tr>';\n  h+='</tbody></table>';\n  if(shift.getTime()!==t2.getTime()){\n    h+='<p>'+fmt(t2)+' is a '+DAY[t2.getUTCDay()]+' or a public holiday, so '\n     +'a T2 transmitted by '+fmt(shift)+' is still on time. That shift is a '\n     +'Canada Revenue Agency administrative rule and this site does not '\n     +'state one for the Ontario Business Registry, so treat '+fmt(due)\n     +' as the Ontario date and see the '\n     +'<a href=\"https://corpnilfilingfor300.ca/tools/due-date-weekend-holiday-shift-calculator/\">weekend and holiday shift calculator</a>.</p>';\n  }\n  if(since==='n'){\n    h+='<h3>There is probably more than one outstanding</h3>';\n    h+='<p>The Canada Revenue Agency stopped accepting the Ontario annual '\n     +'return with the T2 on May 15, 2021, and every one due after '\n     +'October 18, 2021 goes through the Ontario Business Registry. A '\n     +'corporation that has filed none since then has one outstanding for '\n     +'each year that has gone by, not just the current one. The '\n     +'<a href=\"https://corpnilfilingfor300.ca/tools/ontario-missed-annual-returns-calculator/\">Ontario missed annual returns calculator</a> '\n     +'counts them.</p>';\n  }else{\n    h+='<p>You have filed at least one through the Ontario Business Registry '\n     +'already, so the route is the one you know. '+fmt(due)+' is the next '\n     +'one.</p>';\n  }\n  h+='<p>Nil T2 filing at '+PRICE_JS+' covers the T2 on the last row and '\n   +'nothing on the row above it. We tell you the Ontario annual return is '\n   +'due; filing it is a Registry transaction we do not make on your '\n   +'behalf.</p>';\n  h+='<p>'+DISC_JS+'</p>';\n  out.innerHTML=h;\n}\n\nArray.prototype.forEach.call(\n  document.querySelectorAll('#ye,input[name=\"ont\"],input[name=\"since\"]'),\n  function(el){el.addEventListener('change',show);el.addEventListener('input',show);});\nshow();\n\n})();\n</script>\n<!-- /wp:html -->",
