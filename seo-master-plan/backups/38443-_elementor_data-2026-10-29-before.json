[{"id":"05e7ebf","elType":"container","settings":[],"elements":[{"id":"ad33626","elType":"widget","settings":{"html":"\r\n\r\n<style>\r\n.py-wrap{max-width:1100px;margin:0 auto;padding:0 20px}.py-btn-blue{background:rgba(32,135,201,1);color:#fff;padding:13px 26px;border-radius:6px;font-weight:700;text-transform:uppercase;text-decoration:none;display:inline-block}.py-btn-dark{background:#1a2340;color:#fff;padding:13px 26px;border-radius:6px;font-weight:700;text-transform:uppercase;text-decoration:none;display:inline-block}.py-section{padding:52px 20px}.py-section-alt{background:#f7f9fc;padding:52px 20px}.py-section-dark{background:#1a2340;padding:52px 20px}.py-h2{font-weight:800;color:#1a2340;margin-bottom:10px}.py-h2c{font-weight:800;color:#1a2340;margin-bottom:10px;text-align:center}.py-subc{color:#718096;max-width:640px;margin:0 auto 28px;text-align:center}.article p{color:#4a5568;line-height:1.8}.article a{color:rgba(32,135,201,1)}.article h3{font-weight:700;color:#1a2340;margin-bottom:8px}.py-info{background:#f0f7fd;border-left:4px solid rgba(32,135,201,1);border-radius:0 8px 8px 0;padding:14px 18px;margin:18px 0}.py-info p{margin:0;color:#1a2340;line-height:1.7}.py-warn{background:#fffbf0;border-left:4px solid #f6ad1a;border-radius:0 8px 8px 0;padding:14px 18px;margin:18px 0}.py-warn p{margin:0;color:#7c5800;line-height:1.7}.py-hero{background:linear-gradient(135deg,#0f1624 0%,#1a2340 55%,#1e3a6e 100%);padding:52px 20px}.py-hero-inner{max-width:800px;margin:0 auto;text-align:center}.py-hero-eyebrow{display:inline-block;background:rgba(32,135,201,0.15);border:1px solid rgba(32,135,201,0.4);border-radius:50px;padding:5px 16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(32,135,201,1);margin-bottom:16px}.py-hero h1{color:#fff;font-weight:800;line-height:1.2;margin:0 0 14px}.py-hero h1 span{color:#f6ad1a}.py-hero-sub{color:rgba(255,255,255,0.78);max-width:660px;margin:0 auto 22px;line-height:1.75}.py-hero-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.py-tbl{width:100%;border-collapse:collapse;margin:18px 0;border:1px solid #d1d5db}.py-tbl th{background:#1a2340;color:#fff;font-weight:700;padding:12px 14px;text-align:left;border:1px solid #374151}.py-tbl td{padding:10px 14px;border:1px solid #d1d5db;color:#2d3748;line-height:1.5}.py-tbl tr:nth-child(even){background:#f7f9fc}.py-tbl tr:hover{background:#edf2f7}.py-tbl .py-hl{background:#fffbf0;font-weight:600}\r\n.py-calc{max-width:740px;margin:0 auto;background:#fff;border:2px solid #e2e8f0;border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,0.08)}.py-calc-hdr{border-radius:14px 14px 0 0}.py-calc-hdr{background:#1a2340;padding:22px 28px;text-align:center}.py-calc-hdr h2{color:#fff;font-weight:800;margin:0 0 4px}.py-calc-hdr p{color:rgba(255,255,255,0.6);margin:0}.py-calc-body{padding:28px}.py-calc-row{display:flex;gap:16px;margin-bottom:16px;flex-wrap:wrap}.py-calc-field{flex:1;min-width:220px}.py-calc-field label{display:block;font-weight:600;color:#1a2340;margin-bottom:8px;font-size:0.9em}.py-calc-field input[type=\"number\"]{width:100%;padding:11px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:1em;box-sizing:border-box;color:#1a2340;background:#fff}.py-calc-field input[type=\"number\"]:focus{outline:none;border-color:rgba(32,135,201,1);box-shadow:0 0 0 3px rgba(32,135,201,0.15)}.py-pills{display:flex;flex-wrap:wrap;gap:8px}.py-pills input[type=\"radio\"]{display:none}.py-pills label{display:inline-block;padding:9px 16px;border:1px solid #d1d5db;border-radius:6px;cursor:pointer;color:#4a5568;font-size:0.9em;line-height:1.3;transition:all 0.15s;background:#fff}.py-pills label:hover{border-color:rgba(32,135,201,1);color:#1a2340}.py-pills input[type=\"radio\"]:checked+label{background:rgba(32,135,201,1);color:#fff;border-color:rgba(32,135,201,1);font-weight:600}.py-calc-btn{display:block;width:100%;padding:14px;background:rgba(32,135,201,1);color:#fff;font-weight:700;font-size:1.05em;border:none;border-radius:8px;cursor:pointer;text-transform:uppercase;letter-spacing:1px;margin-top:8px}.py-calc-btn:hover{background:#1a6fb5}.py-calc-results{display:none;margin-top:24px;background:#f7f9fc;border-radius:10px;padding:22px;border:1px solid #e2e8f0}.py-calc-results h3{font-weight:700;color:#1a2340;margin-bottom:14px;text-align:center}.py-res-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.py-res-item{background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:14px;text-align:center}.py-res-label{display:block;color:#718096;font-size:0.85em;margin-bottom:4px}.py-res-value{display:block;font-weight:800;color:#1a2340;font-size:1.2em}.py-res-value.green{color:#2d9c4b}.py-res-value.red{color:#e53e3e}.py-res-total{grid-column:1\/-1;background:#1a2340;border-color:#1a2340;border-radius:8px}.py-res-total .py-res-label{color:rgba(255,255,255,0.6)}.py-res-total .py-res-value{color:#f6ad1a}\r\n.py-faq-list{max-width:860px;margin:28px auto 0}.py-faq-item{border:1px solid #e2e8f0;border-radius:8px;margin-bottom:10px;background:#fff;overflow:hidden}.py-faq-q{padding:17px 20px;font-weight:600;color:#1a2340;cursor:pointer;display:flex;justify-content:space-between;align-items:center}.py-faq-q::after{content:\"+\";color:rgba(32,135,201,1);font-weight:300;flex-shrink:0}.py-faq-a{padding:0 20px 16px;color:#718096;line-height:1.7}.py-faq-a a{color:rgba(32,135,201,1)}.py-cta-bottom{background:linear-gradient(135deg,#0f1624,#1a2340);padding:56px 20px;text-align:center}.py-cta-bottom h2{color:#fff;font-weight:800;margin-bottom:10px}.py-cta-bottom p{color:rgba(255,255,255,0.72);max-width:540px;margin:0 auto 22px}.py-cta-feats{display:flex;justify-content:center;gap:26px;flex-wrap:wrap;margin-bottom:26px}.py-cta-feat{color:rgba(255,255,255,.72);display:flex;align-items:center;gap:6px}.py-cta-feat::before{content:\"\\2713\";color:#f6ad1a;font-weight:700}\r\n@media(max-width:600px){.py-res-grid{grid-template-columns:1fr}.py-calc-row{flex-direction:column}}\r\n<\/style>\r\n\r\n<!-- \u2550\u2550 HERO \u2550\u2550 -->\r\n<div class=\"py-hero\"><div class=\"py-hero-inner\"><div class=\"py-hero-eyebrow\">Payroll Guide &#183; Canada 2026<\/div><h1>Payroll Tax Calculator <span>Canada 2026<\/span><\/h1><p class=\"py-hero-sub\">Free Canadian payroll tax calculator with 2026 CPP, EI and federal\/provincial income tax rates. Includes employer cost tables, remittance deadlines, worked dollar examples and CRA penalty rules. Written by a licensed Ontario CPA.<\/p><div class=\"py-hero-btns\"><a href=\"#payroll-calculator\" class=\"py-btn-blue\">Use the Calculator<\/a><a href=\"https:\/\/gondaliyacpa.ca\/payroll-services\/\" class=\"py-btn-dark\">Payroll Services<\/a><\/div><\/div><\/div>\r\n\r\n<!-- \u2550\u2550 CALCULATOR \u2550\u2550 -->\r\n<div class=\"py-section\" id=\"payroll-calculator\"><div class=\"py-wrap\">\r\n<div class=\"py-calc\"><div class=\"py-calc-hdr\"><h2>2026 Payroll Tax Calculator<\/h2><p>Estimate CPP, EI and income tax deductions per pay period<\/p><\/div><div class=\"py-calc-body\">\r\n<div class=\"py-calc-row\"><div class=\"py-calc-field\"><label>Gross Pay Per Period ($)<\/label><input type=\"number\" id=\"pyGross\" placeholder=\"e.g. 5000\" min=\"0\" step=\"0.01\"><\/div><\/div>\r\n<div class=\"py-calc-row\"><div class=\"py-calc-field\"><label>Pay Frequency<\/label><div class=\"py-pills\"><input type=\"radio\" name=\"pyFreq\" id=\"freq26\" value=\"26\" checked><label for=\"freq26\">Bi-Weekly (26)<\/label><input type=\"radio\" name=\"pyFreq\" id=\"freq24\" value=\"24\"><label for=\"freq24\">Semi-Monthly (24)<\/label><input type=\"radio\" name=\"pyFreq\" id=\"freq52\" value=\"52\"><label for=\"freq52\">Weekly (52)<\/label><input type=\"radio\" name=\"pyFreq\" id=\"freq12\" value=\"12\"><label for=\"freq12\">Monthly (12)<\/label><\/div><\/div><\/div>\r\n<div class=\"py-calc-row\"><div class=\"py-calc-field\"><label>Province of Employment<\/label><div class=\"py-pills\"><input type=\"radio\" name=\"pyProv\" id=\"provON\" value=\"ON\" checked><label for=\"provON\">Ontario<\/label><input type=\"radio\" name=\"pyProv\" id=\"provBC\" value=\"BC\"><label for=\"provBC\">British Columbia<\/label><input type=\"radio\" name=\"pyProv\" id=\"provAB\" value=\"AB\"><label for=\"provAB\">Alberta<\/label><input type=\"radio\" name=\"pyProv\" id=\"provSK\" value=\"SK\"><label for=\"provSK\">Saskatchewan<\/label><input type=\"radio\" name=\"pyProv\" id=\"provMB\" value=\"MB\"><label for=\"provMB\">Manitoba<\/label><input type=\"radio\" name=\"pyProv\" id=\"provNB\" value=\"NB\"><label for=\"provNB\">New Brunswick<\/label><input type=\"radio\" name=\"pyProv\" id=\"provNS\" value=\"NS\"><label for=\"provNS\">Nova Scotia<\/label><input type=\"radio\" name=\"pyProv\" id=\"provPE\" value=\"PE\"><label for=\"provPE\">PEI<\/label><input type=\"radio\" name=\"pyProv\" id=\"provNL\" value=\"NL\"><label for=\"provNL\">Newfoundland<\/label><\/div><\/div><\/div>\r\n<div class=\"py-calc-row\"><div class=\"py-calc-field\"><label>TD1 Claim Code<\/label><div class=\"py-pills\"><input type=\"radio\" name=\"pyClaim\" id=\"claim1\" value=\"1\" checked><label for=\"claim1\">Code 1 &#8212; Basic Personal (most common)<\/label><input type=\"radio\" name=\"pyClaim\" id=\"claim0\" value=\"0\"><label for=\"claim0\">No Claim &#8212; Additional Employer<\/label><\/div><\/div><\/div>\r\n<button class=\"py-calc-btn\" onclick=\"calcPayroll()\">Calculate Payroll Deductions<\/button>\r\n<div class=\"py-calc-results\" id=\"pyResults\"><h3>Estimated Payroll Deductions<\/h3><div class=\"py-res-grid\"><div class=\"py-res-item\"><span class=\"py-res-label\">CPP (Employee)<\/span><span class=\"py-res-value\" id=\"resCPP\">$0.00<\/span><\/div><div class=\"py-res-item\"><span class=\"py-res-label\">EI (Employee)<\/span><span class=\"py-res-value\" id=\"resEI\">$0.00<\/span><\/div><div class=\"py-res-item\"><span class=\"py-res-label\">Federal Tax<\/span><span class=\"py-res-value\" id=\"resFed\">$0.00<\/span><\/div><div class=\"py-res-item\"><span class=\"py-res-label\">Provincial Tax<\/span><span class=\"py-res-value\" id=\"resProv\">$0.00<\/span><\/div><div class=\"py-res-item\"><span class=\"py-res-label\">Total Deductions<\/span><span class=\"py-res-value red\" id=\"resTotal\">$0.00<\/span><\/div><div class=\"py-res-item\"><span class=\"py-res-label\">Net Pay (Take-Home)<\/span><span class=\"py-res-value green\" id=\"resNet\">$0.00<\/span><\/div><div class=\"py-res-item py-res-total\"><span class=\"py-res-label\">Total Employer Cost (Gross + Employer CPP + Employer EI)<\/span><span class=\"py-res-value\" id=\"resEmployer\">$0.00<\/span><\/div><\/div><\/div>\r\n<\/div><\/div>\r\n<p style=\"text-align:center;color:#718096;margin-top:14px;font-size:0.88em;\">This calculator provides estimates for general guidance only. It does not replace CRA's official PDOC calculator. Actual deductions may vary based on TD1 credits, additional tax requests and prior-period adjustments. Please consult a licensed CPA for payroll setup. <a href=\"https:\/\/gondaliyacpa.ca\/consultation\/\" style=\"color:rgba(32,135,201,1);\">Book Free Consultation &#8594;<\/a><\/p>\r\n<\/div><\/div>\r\n\r\n<script>\r\nfunction calcPayroll(){var g=parseFloat(document.getElementById('pyGross').value)||0;var f=parseInt(document.querySelector('input[name=\"pyFreq\"]:checked').value);var prov=document.querySelector('input[name=\"pyProv\"]:checked').value;var claim=parseInt(document.querySelector('input[name=\"pyClaim\"]:checked').value);if(g<=0){alert('Please enter a gross pay amount.');return;}\r\nvar annual=g*f;\r\n\/\/ 2026 CPP rates\r\nvar cppRate=0.0595;var cppMax=73200;var cppExempt=3500;var cppMaxContrib=4150.80;\r\nvar cppAnnualPensionable=Math.min(annual,cppMax)-cppExempt;if(cppAnnualPensionable<0)cppAnnualPensionable=0;\r\nvar cppAnnual=Math.min(cppAnnualPensionable*cppRate,cppMaxContrib);var cppPer=cppAnnual\/f;\r\n\/\/ 2026 CPP2 (second ceiling)\r\nvar cpp2Ceil=81300;var cpp2Rate=0.04;var cpp2MaxContrib=324;\r\nvar cpp2Annual=0;if(annual>cppMax){var cpp2Pensionable=Math.min(annual,cpp2Ceil)-cppMax;if(cpp2Pensionable>0)cpp2Annual=Math.min(cpp2Pensionable*cpp2Rate,cpp2MaxContrib);}\r\ncppPer+=(cpp2Annual\/f);var cppAnnualTotal=cppAnnual+cpp2Annual;\r\n\/\/ 2026 EI rates\r\nvar eiRate=0.0164;var eiMax=65700;var eiMaxPrem=1077.48;\r\nvar eiAnnual=Math.min(annual*eiRate,eiMaxPrem);if(annual>eiMax)eiAnnual=eiMaxPrem;var eiPer=eiAnnual\/f;\r\n\/\/ Employer portions\r\nvar empCPPPer=cppPer;var empEIPer=eiPer*1.4;\r\n\/\/ Federal tax 2026 (simplified brackets, lowest rate 14%)\r\nvar fedBPA=claim===1?16129:0;var taxableIncome=annual-cppAnnualTotal-eiAnnual-fedBPA;if(taxableIncome<0)taxableIncome=0;\r\nvar fedTax=0;\r\nif(taxableIncome<=57375)fedTax=taxableIncome*0.14;\r\nelse if(taxableIncome<=114750)fedTax=57375*0.14+(taxableIncome-57375)*0.205;\r\nelse if(taxableIncome<=158468)fedTax=57375*0.14+57375*0.205+(taxableIncome-114750)*0.26;\r\nelse if(taxableIncome<=221708)fedTax=57375*0.14+57375*0.205+43718*0.26+(taxableIncome-158468)*0.29;\r\nelse fedTax=57375*0.14+57375*0.205+43718*0.26+63240*0.29+(taxableIncome-221708)*0.33;\r\nvar fedPer=fedTax\/f;if(fedPer<0)fedPer=0;\r\n\/\/ Provincial tax (simplified Ontario, other provinces approximated)\r\nvar provRates={ON:[{l:52886,r:0.0505},{l:105775,r:0.0915},{l:150000,r:0.1116},{l:220000,r:0.1216},{l:Infinity,r:0.1316}],BC:[{l:47937,r:0.0506},{l:95875,r:0.077},{l:110076,r:0.105},{l:133664,r:0.1229},{l:181232,r:0.147},{l:252752,r:0.168},{l:Infinity,r:0.205}],AB:[{l:148269,r:0.10},{l:177922,r:0.12},{l:237230,r:0.13},{l:355845,r:0.14},{l:Infinity,r:0.15}],SK:[{l:53463,r:0.105},{l:152750,r:0.125},{l:Infinity,r:0.145}],MB:[{l:47000,r:0.108},{l:100000,r:0.1275},{l:Infinity,r:0.174}],NB:[{l:49958,r:0.094},{l:99916,r:0.14},{l:185064,r:0.16},{l:Infinity,r:0.195}],NS:[{l:29590,r:0.0879},{l:59180,r:0.1495},{l:93000,r:0.1667},{l:150000,r:0.175},{l:Infinity,r:0.21}],PE:[{l:32656,r:0.098},{l:64313,r:0.138},{l:105000,r:0.167},{l:140000,r:0.18},{l:Infinity,r:0.183}],NL:[{l:43198,r:0.087},{l:86395,r:0.145},{l:154244,r:0.158},{l:215943,r:0.178},{l:275870,r:0.198},{l:Infinity,r:0.218}]};\r\nvar brackets=provRates[prov]||provRates['ON'];var provBPA=claim===1?11865:0;if(prov==='AB')provBPA=claim===1?22323:0;if(prov==='BC')provBPA=claim===1?12932:0;\r\nvar provTaxable=annual-cppAnnualTotal-eiAnnual-provBPA;if(provTaxable<0)provTaxable=0;\r\nvar provTax=0;var prev=0;for(var i=0;i<brackets.length;i++){var b=brackets[i];var amt=Math.min(provTaxable,b.l)-prev;if(amt>0)provTax+=amt*b.r;prev=b.l;if(provTaxable<=b.l)break;}\r\nvar provPer=provTax\/f;if(provPer<0)provPer=0;\r\nvar totalDed=cppPer+eiPer+fedPer+provPer;var netPay=g-totalDed;var employerCost=g+empCPPPer+empEIPer;\r\nfunction fmt(n){return'$'+n.toFixed(2).replace(\/\\B(?=(\\d{3})+(?!\\d))\/g,',');}\r\ndocument.getElementById('resCPP').textContent=fmt(cppPer);document.getElementById('resEI').textContent=fmt(eiPer);document.getElementById('resFed').textContent=fmt(fedPer);document.getElementById('resProv').textContent=fmt(provPer);document.getElementById('resTotal').textContent=fmt(totalDed);document.getElementById('resNet').textContent=fmt(netPay);document.getElementById('resEmployer').textContent=fmt(employerCost);document.getElementById('pyResults').style.display='block';}\r\n<\/script>\r\n\r\n<!-- \u2550\u2550 2026 RATES \u2550\u2550 -->\r\n<div class=\"py-section-alt\"><div class=\"py-wrap article\"><h2 class=\"py-h2\">2026 Canadian Payroll Tax Rates &#8212; CPP, CPP2, EI and Income Tax<\/h2><p>The following rates are effective January 1, 2026. These are the rates used by CRA's Payroll Deductions Online Calculator (PDOC) and by every Canadian payroll system.<\/p>\r\n\r\n<table class=\"py-tbl\"><thead><tr><th>Deduction<\/th><th>Employee Rate<\/th><th>Employer Rate<\/th><th>Maximum Insurable \/ Pensionable<\/th><th>Annual Maximum Contribution<\/th><\/tr><\/thead><tbody>\r\n<tr class=\"py-hl\"><td>CPP (first ceiling)<\/td><td>5.95%<\/td><td>5.95%<\/td><td>$73,200<\/td><td>$4,150.80 (employee)<\/td><\/tr>\r\n<tr><td>CPP2 (second ceiling)<\/td><td>4.00%<\/td><td>4.00%<\/td><td>$81,300<\/td><td>$324.00 (employee)<\/td><\/tr>\r\n<tr><td>CPP basic exemption<\/td><td colspan=\"4\">$3,500 per year (prorated per pay period)<\/td><\/tr>\r\n<tr class=\"py-hl\"><td>EI<\/td><td>1.64%<\/td><td>2.296% (1.4x employee rate)<\/td><td>$65,700<\/td><td>$1,077.48 (employee) \/ $1,508.47 (employer)<\/td><\/tr>\r\n<tr><td>Federal income tax &#8212; lowest bracket<\/td><td>14% on first $57,375<\/td><td>N\/A<\/td><td colspan=\"2\">Basic personal amount: $16,129<\/td><\/tr>\r\n<tr><td>Federal income tax &#8212; second bracket<\/td><td>20.5% on $57,376 &#8211; $114,750<\/td><td>N\/A<\/td><td colspan=\"2\">&#8212;<\/td><\/tr>\r\n<tr><td>Federal income tax &#8212; third bracket<\/td><td>26% on $114,751 &#8211; $158,468<\/td><td>N\/A<\/td><td colspan=\"2\">&#8212;<\/td><\/tr>\r\n<tr><td>Federal income tax &#8212; fourth bracket<\/td><td>29% on $158,469 &#8211; $221,708<\/td><td>N\/A<\/td><td colspan=\"2\">&#8212;<\/td><\/tr>\r\n<tr><td>Federal income tax &#8212; top bracket<\/td><td>33% on $221,709+<\/td><td>N\/A<\/td><td colspan=\"2\">&#8212;<\/td><\/tr>\r\n<\/tbody><\/table>\r\n\r\n<div class=\"py-info\"><p><strong>2026 Change &#8212; Lowest Federal Bracket:<\/strong> The lowest federal tax bracket rate changed from 15% to 14% effective for 2026. This reduces federal income tax for every Canadian employee at all income levels.<\/p><\/div>\r\n<\/div><\/div>\r\n\r\n<!-- \u2550\u2550 ONTARIO PROVINCIAL RATES \u2550\u2550 -->\r\n<div class=\"py-section\"><div class=\"py-wrap article\"><h2 class=\"py-h2\">2026 Ontario Provincial Income Tax Rates for Payroll<\/h2>\r\n\r\n<table class=\"py-tbl\"><thead><tr><th>Taxable Income Bracket<\/th><th>Ontario Rate<\/th><th>Combined Federal + Ontario<\/th><\/tr><\/thead><tbody>\r\n<tr><td>First $52,886<\/td><td>5.05%<\/td><td>19.05%<\/td><\/tr>\r\n<tr><td>$52,887 &#8211; $105,775<\/td><td>9.15%<\/td><td>29.65%<\/td><\/tr>\r\n<tr><td>$105,776 &#8211; $150,000<\/td><td>11.16%<\/td><td>37.16%<\/td><\/tr>\r\n<tr><td>$150,001 &#8211; $220,000<\/td><td>12.16%<\/td><td>41.16%<\/td><\/tr>\r\n<tr class=\"py-hl\"><td>Over $220,000<\/td><td>13.16%<\/td><td>46.16% &#8211; 53.53%<\/td><\/tr>\r\n<\/tbody><\/table>\r\n<p>Ontario also applies the Ontario Health Premium (OHP) on taxable income above $20,000. The OHP is calculated separately and ranges from $300 to $900 per year. It is not deducted at source by the employer &#8212; it is assessed on the employee's T1 personal return.<\/p>\r\n<\/div><\/div>\r\n\r\n<!-- \u2550\u2550 EMPLOYER COST TABLE \u2550\u2550 -->\r\n<div class=\"py-section-alt\"><div class=\"py-wrap article\"><h2 class=\"py-h2\">True Employer Cost Per Employee &#8212; Ontario 2026<\/h2><p>When you hire an employee, the gross salary is not your total cost. The employer pays CPP (matching the employee contribution), EI (at 1.4x the employee rate), WSIB premiums (industry-specific) and any benefits. The following table shows the total employer payroll cost at common salary levels in Ontario.<\/p>\r\n\r\n<table class=\"py-tbl\"><thead><tr><th>Annual Salary<\/th><th>Employer CPP + CPP2<\/th><th>Employer EI<\/th><th>Total Payroll Taxes (Employer)<\/th><th>True Cost to Employer<\/th><\/tr><\/thead><tbody>\r\n<tr><td>$40,000<\/td><td>$2,172<\/td><td>$656<\/td><td>$2,828<\/td><td>$42,828<\/td><\/tr>\r\n<tr><td>$60,000<\/td><td>$3,362<\/td><td>$984<\/td><td>$4,346<\/td><td>$64,346<\/td><\/tr>\r\n<tr class=\"py-hl\"><td>$80,000<\/td><td>$4,475<\/td><td>$1,312<\/td><td>$5,787<\/td><td>$85,787<\/td><\/tr>\r\n<tr><td>$100,000<\/td><td>$4,475<\/td><td>$1,509<\/td><td>$5,984<\/td><td>$105,984<\/td><\/tr>\r\n<tr><td>$130,000<\/td><td>$4,475<\/td><td>$1,509<\/td><td>$5,984<\/td><td>$135,984<\/td><\/tr>\r\n<\/tbody><\/table>\r\n\r\n<div class=\"py-warn\"><p><strong>WSIB Not Included:<\/strong> The table above does not include WSIB premiums, which vary by industry classification. Construction trades in Ontario pay $2.00&#8211;$6.00 per $100 of insurable earnings. Office-based professional services pay $0.18&#8211;$0.50 per $100. WSIB premiums are an additional employer cost on top of CPP and EI.<\/p><\/div>\r\n<\/div><\/div>\r\n\r\n<!-- \u2550\u2550 REMITTANCE DEADLINES \u2550\u2550 -->\r\n<div class=\"py-section\"><div class=\"py-wrap article\"><h2 class=\"py-h2\">CRA Payroll Remittance Deadlines 2026<\/h2><p>Employers must remit CPP, EI and income tax deductions to CRA based on their remitter type. CRA assigns your remitting frequency based on your average monthly withholding amount (AMWA).<\/p>\r\n\r\n<table class=\"py-tbl\"><thead><tr><th>Remitter Type<\/th><th>AMWA Threshold<\/th><th>Remittance Deadline<\/th><\/tr><\/thead><tbody>\r\n<tr><td>Regular remitter (new employers default)<\/td><td>Under $25,000<\/td><td>15th of the month following the pay date<\/td><\/tr>\r\n<tr><td>Quarterly remitter<\/td><td>Under $1,000 (and qualifying conditions)<\/td><td>15th of the month following the quarter-end<\/td><\/tr>\r\n<tr class=\"py-hl\"><td>Accelerated remitter &#8212; Threshold 1<\/td><td>$25,000 &#8211; $99,999.99<\/td><td>Twice monthly: 25th for first 15 days, 10th of next month for remaining<\/td><\/tr>\r\n<tr><td>Accelerated remitter &#8212; Threshold 2<\/td><td>$100,000+<\/td><td>Within 3 business days of each pay date<\/td><\/tr>\r\n<\/tbody><\/table>\r\n\r\n<div class=\"py-warn\"><p><strong>Late Remittance Penalties:<\/strong> CRA charges escalating penalties for late payroll remittances: 3% (1&#8211;3 days late), 5% (4&#8211;5 days), 7% (6&#8211;7 days) and 10% (more than 7 days or repeat offences). Directors are personally liable for unremitted payroll deductions under Section 227.1 of the Income Tax Act &#8212; even if the corporation is insolvent. This is one of the few corporate liabilities that pierces the corporate veil.<\/p><\/div>\r\n<\/div><\/div>\r\n\r\n<!-- \u2550\u2550 WORKED EXAMPLES \u2550\u2550 -->\r\n<div class=\"py-section-alt\"><div class=\"py-wrap article\"><h2 class=\"py-h2\">Worked Payroll Examples &#8212; Ontario 2026<\/h2>\r\n\r\n<table class=\"py-tbl\"><thead><tr><th>Item<\/th><th>Employee A &#8212; $60,000\/yr Bi-Weekly<\/th><th>Employee B &#8212; $100,000\/yr Bi-Weekly<\/th><\/tr><\/thead><tbody>\r\n<tr><td>Gross pay per period<\/td><td>$2,307.69<\/td><td>$3,846.15<\/td><\/tr>\r\n<tr><td>CPP (employee)<\/td><td>$129.30<\/td><td>$172.14<\/td><\/tr>\r\n<tr><td>EI (employee)<\/td><td>$37.85<\/td><td>$41.45<\/td><\/tr>\r\n<tr><td>Federal income tax<\/td><td>$165.42<\/td><td>$383.28<\/td><\/tr>\r\n<tr><td>Ontario income tax<\/td><td>$83.18<\/td><td>$214.62<\/td><\/tr>\r\n<tr class=\"py-hl\"><td>Total deductions<\/td><td>$415.75<\/td><td>$811.49<\/td><\/tr>\r\n<tr class=\"py-hl\"><td>Net pay (take-home)<\/td><td>$1,891.94<\/td><td>$3,034.66<\/td><\/tr>\r\n<tr><td>Employer CPP<\/td><td>$129.30<\/td><td>$172.14<\/td><\/tr>\r\n<tr><td>Employer EI (1.4x)<\/td><td>$52.99<\/td><td>$58.03<\/td><\/tr>\r\n<tr class=\"py-hl\"><td>True employer cost per period<\/td><td>$2,489.98<\/td><td>$4,076.32<\/td><\/tr>\r\n<\/tbody><\/table>\r\n<\/div><\/div>\r\n\r\n<!-- \u2550\u2550 SALARY VS DIVIDENDS FOR OWNER-MANAGERS \u2550\u2550 -->\r\n<div class=\"py-section\"><div class=\"py-wrap article\"><h2 class=\"py-h2\">Salary vs. Dividends for Owner-Managers &#8212; Payroll Implications<\/h2><p>Incorporated business owners in Canada can pay themselves salary, dividends or a combination. The payroll tax implications differ significantly.<\/p>\r\n\r\n<table class=\"py-tbl\"><thead><tr><th>Factor<\/th><th>Salary<\/th><th>Dividends<\/th><\/tr><\/thead><tbody>\r\n<tr><td>CPP contributions<\/td><td>Yes &#8212; employer + employee portions both paid by the corporation<\/td><td>No CPP on dividends<\/td><\/tr>\r\n<tr><td>EI premiums<\/td><td>Yes &#8212; unless owner with >40% control opts out (employer portion still due if opted in)<\/td><td>No EI on dividends<\/td><\/tr>\r\n<tr><td>Income tax at source<\/td><td>Yes &#8212; deducted from each paycheque<\/td><td>No withholding at source &#8212; reported on T5<\/td><\/tr>\r\n<tr><td>RRSP contribution room<\/td><td>Yes &#8212; 18% of T4 salary creates RRSP room<\/td><td>No &#8212; dividends do not create RRSP room<\/td><\/tr>\r\n<tr><td>Corporate deduction<\/td><td>Yes &#8212; salary is a deductible expense<\/td><td>No &#8212; dividends paid from after-tax earnings<\/td><\/tr>\r\n<tr class=\"py-hl\"><td>Payroll processing required?<\/td><td>Yes &#8212; T4, ROE, CRA remittances, year-end filing<\/td><td>No payroll processing &#8212; T5 slip only<\/td><\/tr>\r\n<\/tbody><\/table>\r\n\r\n<div class=\"py-info\"><p><strong>Our Recommendation:<\/strong> Most owner-managers benefit from a combination &#8212; salary sufficient to maximise RRSP room ($32,490 for 2026 maximum) and to fund CPP (retirement and disability benefits), with the remainder as dividends. We model the optimal split for every corporate client annually. <a href=\"https:\/\/gondaliyacpa.ca\/consultation\/\">Get CPA Advice &#8594;<\/a><\/p><\/div>\r\n<\/div><\/div>\r\n\r\n<!-- \u2550\u2550 HOW WE HELP \u2550\u2550 -->\r\n<div class=\"py-section-dark\"><div class=\"py-wrap\"><h2 class=\"py-h2c\" style=\"color:#fff;\">Let Gondaliya CPA Handle Your Payroll<\/h2><p style=\"text-align:center;color:rgba(255,255,255,0.65);max-width:680px;margin:0 auto;\">We process payroll, calculate CPP\/EI\/tax deductions, remit to CRA, prepare T4s and ROEs, and file year-end payroll returns for Ontario businesses at flat-fee pricing. Your corporate tax return is included FREE with every bookkeeping and payroll engagement.<\/p><div style=\"text-align:center;margin-top:28px;\"><a href=\"https:\/\/gondaliyacpa.ca\/payroll-services\/\" class=\"py-btn-blue\" style=\"margin:0 6px;\">Payroll Services<\/a><a href=\"https:\/\/gondaliyacpa.ca\/consultation\/\" style=\"margin:0 6px;background:transparent;color:#fff;padding:11px 24px;border-radius:6px;font-weight:700;text-transform:uppercase;border:2px solid rgba(255,255,255,0.4);text-decoration:none;display:inline-block;\">Book Free Consultation<\/a><\/div><\/div><\/div>\r\n\r\n<!-- \u2550\u2550 FAQ \u2550\u2550 -->\r\n<div class=\"py-section\"><div class=\"py-wrap\"><h2 class=\"py-h2c\">Frequently Asked Questions &#8212; Payroll Tax Calculator Canada<\/h2><div class=\"py-faq-list\">\r\n\r\n<div class=\"py-faq-item\"><div class=\"py-faq-q\">What payroll deductions must a Canadian employer withhold?<\/div><div class=\"py-faq-a\">Canadian employers must deduct three items from every employee paycheque: Canada Pension Plan (CPP) contributions, Employment Insurance (EI) premiums and federal\/provincial income tax. The employer must also contribute the matching CPP amount and 1.4x the employee EI amount. All deductions must be remitted to CRA by the applicable deadline. <a href=\"https:\/\/gondaliyacpa.ca\/payroll-services\/\">Payroll Services &#8594;<\/a><\/div><\/div>\r\n\r\n<div class=\"py-faq-item\"><div class=\"py-faq-q\">What is the CPP rate for 2026?<\/div><div class=\"py-faq-a\">The 2026 CPP contribution rate is 5.95% for both the employee and employer on pensionable earnings between $3,500 and $73,200. The maximum annual employee contribution is $4,150.80. CPP2 applies at 4% on earnings between $73,200 and $81,300, with a maximum of $324. The employer matches both the CPP and CPP2 contributions.<\/div><\/div>\r\n\r\n<div class=\"py-faq-item\"><div class=\"py-faq-q\">What is the EI rate for 2026?<\/div><div class=\"py-faq-a\">The 2026 EI premium rate is 1.64% for employees on insurable earnings up to $65,700. The maximum annual employee premium is $1,077.48. The employer pays 1.4 times the employee rate (2.296%), for a maximum of $1,508.47 per year.<\/div><\/div>\r\n\r\n<div class=\"py-faq-item\"><div class=\"py-faq-q\">When must I remit payroll deductions to CRA?<\/div><div class=\"py-faq-a\">Regular remitters (most small businesses) must remit by the 15th of the month following the pay date. Accelerated Threshold 1 remitters ($25K&#8211;$100K AMWA) remit twice monthly. Threshold 2 remitters ($100K+ AMWA) remit within 3 business days of each pay date. Late remittance penalties range from 3% to 10%.<\/div><\/div>\r\n\r\n<div class=\"py-faq-item\"><div class=\"py-faq-q\">What happens if I remit payroll deductions late?<\/div><div class=\"py-faq-a\">CRA charges escalating penalties: 3% (1&#8211;3 days late), 5% (4&#8211;5 days), 7% (6&#8211;7 days) and 10% (more than 7 days or repeat offences within the same year). Directors are personally liable for unremitted payroll deductions under Section 227.1 &#8212; CRA can assess directors personally even if the corporation is bankrupt.<\/div><\/div>\r\n\r\n<div class=\"py-faq-item\"><div class=\"py-faq-q\">Can a business owner opt out of EI?<\/div><div class=\"py-faq-a\">Shareholders who control more than 40% of voting shares can opt out of EI &#8212; meaning neither the employee nor employer EI premiums are required. However, opting out means the owner-manager is not eligible for EI benefits (including maternity, parental and sickness benefits). CPP cannot be opted out of for employees receiving T4 salary.<\/div><\/div>\r\n\r\n<div class=\"py-faq-item\"><div class=\"py-faq-q\">Should I pay myself salary or dividends from my corporation?<\/div><div class=\"py-faq-a\">Salary creates RRSP room and CPP contributions (retirement and disability). Dividends avoid CPP and EI but do not create RRSP room. Most owner-managers benefit from a combination &#8212; enough salary for RRSP maximisation ($32,490 for 2026) plus CPP, with the remainder as dividends. We model the optimal split for every corporate client annually. <a href=\"https:\/\/gondaliyacpa.ca\/consultation\/\">Get CPA Advice &#8594;<\/a><\/div><\/div>\r\n\r\n<div class=\"py-faq-item\"><div class=\"py-faq-q\">How much does payroll processing cost for a small business?<\/div><div class=\"py-faq-a\">Gondaliya CPA provides payroll processing for Ontario businesses as part of our flat-fee bookkeeping and tax engagements. Processing includes CPP\/EI\/tax calculations, CRA remittances, T4 preparation, ROE filing and year-end payroll reconciliation. Under our 60-Day Fees-Matching Policy, we match any lower written quote from a licensed Ontario CPA firm. <a href=\"https:\/\/gondaliyacpa.ca\/pricing-calculation\/\">Know Your Exact Fee &#8594;<\/a><\/div><\/div>\r\n\r\n<\/div><\/div><\/div>\r\n\r\n<!-- \u2550\u2550 CTA BOTTOM \u2550\u2550 -->\r\n<div class=\"py-cta-bottom\"><h2>Stop Calculating Payroll by Hand. Let a CPA Handle It.<\/h2><p>Gondaliya CPA processes payroll, remits to CRA, files T4s and includes your corporate tax return FREE with every engagement. 1450+ five-star reviews.<\/p><div class=\"py-cta-feats\"><div class=\"py-cta-feat\">Licensed CPA Ontario<\/div><div class=\"py-cta-feat\">1450+ Five-Star Reviews<\/div><div class=\"py-cta-feat\">30-Day Money-Back Guarantee<\/div><div class=\"py-cta-feat\">Flat-Fee Payroll<\/div><\/div><a href=\"https:\/\/gondaliyacpa.ca\/payroll-services\/\" class=\"py-btn-blue\" style=\"margin:0 6px;\">Payroll Services<\/a><a href=\"https:\/\/gondaliyacpa.ca\/consultation\/\" style=\"margin:0 6px;background:transparent;color:#fff;padding:11px 24px;border-radius:6px;font-weight:700;text-transform:uppercase;border:2px solid rgba(255,255,255,0.4);text-decoration:none;display:inline-block;\">Book Free Consultation<\/a><\/div>\r\n\r\n<div style=\"padding:52px 20px;background:#f7f9fc;\"><div style=\"max-width:1100px;margin:0 auto;text-align:center;\"><h2 style=\"font-weight:800;color:#1a2340;margin-bottom:8px;\">Google Reviews<\/h2><p style=\"color:#718096;max-width:600px;margin:0 auto 28px;\">1450+ five-star reviews from Ontario businesses trusting Gondaliya CPA with payroll and corporate tax.<\/p><script defer async src='https:\/\/cdn.trustindex.io\/loader.js?3d7613063935419a40268ae9f69'><\/script><div style=\"margin-top:18px;\"><a href=\"https:\/\/g.co\/kgs\/UXaRRT4\" target=\"_blank\" rel=\"noopener\" style=\"font-weight:600;color:rgba(32,135,201,1);text-decorati